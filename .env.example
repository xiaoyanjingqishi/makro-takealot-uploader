# ==============================================================================
# Makro-Takealot 智能搬品与多店铺自动化运营系统 - 环境变量配置示例模板
# 复制此文件为 .env 并根据实际环境调整配置参数
# ==============================================================================

# ----------------- 基础系统配置 -----------------
PROJECT_NAME="Makro-Takealot 智能搬品系统"
SYSTEM_VERSION="2.1.3"
EXTENSION_VERSION="1.1.3"
# 数据库连接串 (默认使用 SQLite，生产环境亦可无缝切换 PostgreSQL / MySQL)
# DATABASE_URL="sqlite:///makro_app.db"

# ----------------- AI 清洗与质检大模型配置 -----------------
# 首选 AI 服务提供商: 'deepseek' 或 'qwen'
AI_PROVIDER="deepseek"

# 1. DeepSeek 配置 (推荐，性价比高，语义结构化能力强)
DEEPSEEK_API_KEY="your-deepseek-api-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_VISION_MODEL="deepseek-flash"

# 2. 阿里云通义千问配置 (DashScope OpenAI 兼容接口)
QWEN_API_KEY="your-qwen-api-key-here"
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"
DEFAULT_QWEN_VISION_MODEL="qwen-vl-plus"

# 3. AI 清洗模式: 'text' (纯文本高速清洗) 或 'vision' (图文多模态深度首图质检)
DEFAULT_CLEANER_MODE="text"

# 4. Jev (TypeSafe AI) 决策/裁决模型
JEV_ENABLED=false
JEV_API_KEY=""
JEV_BASE_URL="https://api.typesafe.ai"
JEV_MODEL="jev-latest"

# ----------------- 默认商品刊登与定价策略配置 -----------------
# 售价加价比例 (原价 * 1.35)
DEFAULT_MARKUP_RATIO=1.35
# 固定加价金额 (兰特 ZAR)
DEFAULT_FIXED_MARKUP=20.0
# 划线原价倍率 (MRP = 售价 * 1.5)
DEFAULT_MRP_RATIO=1.5

# 标题 SEO 关键词扩展配置
DEFAULT_SEO_TITLE_ENABLED=true
DEFAULT_SEO_TITLE_MAX_LEN=120

# ----------------- 默认 Makro 店铺刊登参数 -----------------
# 系统启动时如无店铺将自动以该配置初始化首个默认店铺
DEFAULT_SELLER_ID="cb80491bf0a34dc5"
DEFAULT_FK_CSRF_TOKEN="FbvXzXEP-45o5eUtkeX8Wo6LCq9GBWDg9Rcg"
DEFAULT_BRAND="Beishi"
DEFAULT_SHIPPING_DAYS="15"
DEFAULT_COUNTRY_OF_ORIGIN="CN"
DEFAULT_MANUFACTURER="Beijing"
DEFAULT_PACKER="BeiShi"
DEFAULT_SERVICE_PROFILE="NON_FBF"

# 默认包装尺寸 (长宽高 cm，重量 kg)
DEFAULT_PKG_LENGTH="20"
DEFAULT_PKG_BREADTH="15"
DEFAULT_PKG_HEIGHT="5"
DEFAULT_PKG_WEIGHT="0.5"

# 上品执行模式: 'backend' (后端直接发包协议刊登) 或 'extension' (通过浏览器插件上下文代发)
UPLOAD_MODE="backend"

# 默认批量上品并发线程数 (推荐 2~3，避免触发平台短时流控)
DEFAULT_PUBLISH_CONCURRENCY=2
